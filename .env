# URL del endpoint GraphQL (solo variables con prefijo VITE_ llegan al código del navegador).
#
# Desarrollo (npm run dev): déjalo comentado. Vite sirve `/graphql` y lo reenvía a http://localhost:4000
# según vite.config.js. Si ejecutas el build estático sin proxy, descomenta la línea de abajo.
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
#
# Producción: URL absoluta real del backend (HTTPS recomendado).
# VITE_GRAPHQL_URL=https://api.tudominio.com/graphql
